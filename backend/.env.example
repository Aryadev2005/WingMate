NODE_ENV=production
PORT=8080
# Node processes per container (use ~1 per CPU core)
WEB_CONCURRENCY=2
DATABASE_URL=postgres://wingmate:password@db:5432/wingmate
DB_POOL_MAX=20
REDIS_URL=redis://redis:6379
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Any OpenAI-compatible provider. Examples:
#   OpenRouter: https://openrouter.ai/api/v1   (one key, many cheap models)
#   DeepSeek:   https://api.deepseek.com/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
# Your provider's real prices (USD per 1M tokens) so cost per message is tracked accurately
LLM_PRICE_IN_PER_M=0.30
LLM_PRICE_OUT_PER_M=1.00
# Optional second provider, used only if the first is down
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

FREE_MESSAGES_PER_DAY=5
PLUS_MESSAGES_PER_DAY=300
MAX_REPLY_TOKENS_FREE=350
MAX_REPLY_TOKENS_PLUS=600
PLUS_MONTHLY_PRICE=$7.99
PLUS_YEARLY_PRICE=$49.99

# RevenueCat → Project settings → Integrations → Webhooks → Authorization header value
REVENUECAT_WEBHOOK_SECRET=
